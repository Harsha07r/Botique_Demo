# Copy to .env.local for local work. NEVER commit real values.
# Leave the Sanity vars empty to run on the sample catalogue in data/products.seed.json.

# Public site URL used in WhatsApp links and share previews (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://vastrika.in

# Sanity (public identifiers, safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret: webhook signature secret for /api/revalidate (instant refresh on publish)
SANITY_REVALIDATE_SECRET=

# Secret: only for `npm run seed` (Editor token). Never needed on Vercel.
SANITY_API_WRITE_TOKEN=

# Fallback WhatsApp number (digits only, with country code) if not set in the CMS
NEXT_PUBLIC_WHATSAPP_NUMBER=
